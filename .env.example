# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: gemini | openai | anthropic | azure
AI_PROVIDER=gemini

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Free tier: 15 req/min — get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_API_VERSION=2024-02-01

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
